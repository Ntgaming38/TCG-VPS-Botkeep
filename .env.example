NODE_ENV=development
PORT=3000
# MySQL/TiDB connection string
DATABASE_URL=mysql://user:password@host:4000/dbname?ssl=%7B%22rejectUnauthorized%22%3Atrue%7D
JWT_SECRET=change-me-to-a-long-random-string
# Admin seed account (used by local auth when no OAuth server is configured)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me
ADMIN_OPENID=local-admin
# Secret shared with VPS cron jobs (x-cron-secret header)
CRON_SECRET=change-me-cron-secret
# Where uploaded files and backup archives are stored
STORAGE_DIR=./dist/public/uploads
# Optional Gmail SMTP for email verification / password recovery (Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TCG Manager <no-reply@example.com>"
EMAIL_CODE_SECRET=change-me-long-random-string
# Optional Google OAuth (requires a Google OAuth web client and HTTPS domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=